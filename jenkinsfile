pipeline {
    agent any

    environment {
        APP_NAME = "mywebsite"
        IMAGE_TAG = "1.0"
        HOST_PORT = "9001"
        CONTAINER_PORT = "80"
    }

    stages {
        stage('Build Image') {
            steps {
                sh "docker build -t ${APP_NAME}:${IMAGE_TAG} ."
            }
        }

        stage('Run Container') {
            steps {
                sh "docker run -d -p ${HOST_PORT}:${CONTAINER_PORT} ${APP_NAME}:${IMAGE_TAG}"
            }
        }
    }
}
